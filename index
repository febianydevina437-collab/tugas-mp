        function openMemberModal(key) {
            const m = membersData[key];
            document.getElementById('modalEmoji').textContent = m.emoji;
            document.getElementById('modalRole').textContent = m.role;
            document.getElementById('modalName').textContent = m.name;
            document.getElementById('modalFullName').textContent = m.fullName;
            document.getElementById('modalBirth').textContent = m.birth;
            document.getElementById('modalNation').textContent = m.nation;
            document.getElementById('modalMbti').textContent = m.mbti;
            document.getElementById('modalBio').textContent = m.bio;

            document.getElementById('modalImg1').src = m.img1;
            document.getElementById('modalImg1').alt = m.name + ' 1';
            document.getElementById('modalImg2').src = m.img2;
            document.getElementById('modalImg2').alt = m.name + ' 2';
            document.getElementById('modalImg3').src = m.img3;
            document.getElementById('modalImg3').alt = m.name + ' 3';

            const modal = document.getElementById('memberModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function hideModal() {
            const modal = document.getElementById('memberModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function closeMemberModal(event) {
            if (event.target.id === 'memberModal') {
                hideModal();
            }
        }

        function selectPlan(planName) {
            document.getElementById('selectedPlanInput').value = planName;
            document.getElementById('subscribeSuccess').classList.add('hidden');
        }

        function handleSubscribe(event) {
            event.preventDefault();
            document.getElementById('subscribeSuccess').classList.remove('hidden');
        }
    </script>

